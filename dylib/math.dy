abs(s32 x) -> s32 {
    if(x < 0) {
        return 0 - x;
    }

    return x;
}

min(s32 x, s32 y) -> s32 {
    if(x < y) {
        return x;
    }

    return y;
}

max(s32 x, s32 y) -> s32 {
    if(x > y) {
        return x;
    }

    return y;
}

clamp(s32 x, s32 y, s32 z) -> s32 {
    if(x < y) {
        return y;
    }

    if(x > z) {
        return z;
    }

    return x;
}

pow(s32 x, s32 y) -> s32 {
    s32 result = 1;
    loop(y > 0) {
        result = result * x;
        y--;
    }

    return result;
}